# Environment Mode: development | testing | production
ENVIRONMENT=development

# Database URL
# If left blank, automatically falls back to: sqlite+aiosqlite:///./data/app.db
# For PostgreSQL via Docker Compose: postgresql+asyncpg://user:password@localhost:5432/billing_db
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# Stripe Configuration (Test Mode Only)
# Get your test key from dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_placeholder_key

# Webhook signing secret from `stripe listen --forward-to localhost:8000/api/v1/billing/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret

# Optional: Pre-provisioned Stripe Price ID for Pro plan ($29/month)
# If not set, seed.py will automatically create one via Stripe API
STRIPE_PRO_PRICE_ID=price_placeholder_pro

# API Configuration
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
